{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Amarel-Taylor-Scott/github-radar/main/schemas/project-radar-manifest-v2.schema.json",
  "title": "GitHub Project Radar publication manifest v2",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "source_commit",
    "file_count",
    "total_bytes",
    "files"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "schema_url": { "type": "string", "format": "uri" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_commit": { "type": "string" },
    "file_count": { "type": "integer", "minimum": 0 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "path", "bytes", "sha256"],
        "properties": {
          "scope": { "enum": ["feed", "site"] },
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
