      "platforms": ["claude", "codex", "mcp"],
      "catalogs": ["claude-tools"],
      "trust": 0.42,
      "sort": "stars",
      "max_results": 40
    },
    {
      "id": "model-context-protocol-topic",
      "query": "topic:model-context-protocol",
      "kind": "tool",
      "platforms": ["claude", "codex", "mcp"],
      "catalogs": ["claude-tools"],
      "trust": 0.42,
      "sort": "stars",
      "max_results": 40
    },
    {
      "id": "claude-mcp-keywords",
      "query": "claude mcp in:name,description,readme",
      "kind": "tool",
      "platforms": ["claude", "mcp"],
      "catalogs": ["claude-tools"],
      "trust": 0.38,
      "sort": "stars",
      "max_results": 30
    },
    {
      "id": "claude-tool-keywords",
